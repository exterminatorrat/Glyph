{
  "name": "glyph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "research:carrier:generate": "node scripts/generate-docx-carrier-spike.ts",
    "research:carrier:inspect": "node scripts/inspect-docx-carrier-spike.ts",
    "research:carrier:bakeoff:generate": "node scripts/generate-docx-alternative-carrier.ts",
    "research:carrier:bakeoff:inspect": "node scripts/inspect-docx-alternative-carrier.ts",
    "research:carrier:bakeoff:validate": "node scripts/validate-docx-alternative-carrier-run.ts",
    "research:carrier:semantic-white:generate": "node scripts/generate-docx-semantic-white-carrier.ts",
    "research:carrier:semantic-white:inspect": "node scripts/inspect-docx-semantic-white-carrier.ts",
    "research:carrier:semantic-white:validate": "node scripts/validate-docx-semantic-white-carrier-run.ts",
    "research:carrier:zero-width:generate": "node scripts/generate-docx-zero-width-carrier.ts",
    "research:carrier:zero-width:inspect-docx": "node scripts/inspect-docx-zero-width-carrier.ts",
    "research:carrier:zero-width:inspect-text": "node scripts/inspect-zero-width-plain-text.ts",
    "research:carrier:zero-width:validate": "node scripts/validate-docx-zero-width-carrier-run.ts",
    "research:carrier:join-control-qualification:generate": "node scripts/generate-docx-join-control-qualification.ts",
    "research:carrier:join-control-qualification:inspect-docx": "node scripts/inspect-docx-join-control-qualification.ts",
    "research:carrier:join-control-qualification:inspect-text": "node scripts/inspect-text-join-control-qualification.ts",
    "research:carrier:join-control-qualification:inspect-pdf": "node scripts/inspect-pdf-join-control-qualification.ts",
    "research:carrier:join-control-qualification:render-pdf": "node scripts/render-pdf-join-control-qualification.ts",
    "research:carrier:join-control-qualification:validate": "node scripts/validate-docx-join-control-qualification-run.ts"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "docx": "9.7.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "fflate": "0.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
